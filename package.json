{
  "name": "maqlab",
  "version": "1.0.0",
  "private": true,
  "description": "MAQLAB (مقلب) — bilingual (ar/en) multiplayer party game",
  "main": "server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "check": "node scripts/validate-content.js --strict",
    "check:new": "node scripts/validate-content.js --new --strict",
    "prestart": "node scripts/validate-content.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "socket.io-client": "^4.8.3"
  }
}
